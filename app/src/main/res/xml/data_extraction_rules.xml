<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="photos/" />
        <exclude domain="sharedpref" path="besharp_remote_consent.xml" />
        <exclude domain="sharedpref" path="besharp_custom_api.xml" />
        <exclude domain="sharedpref" path="besharp_secure_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="photos/" />
        <exclude domain="sharedpref" path="besharp_remote_consent.xml" />
        <exclude domain="sharedpref" path="besharp_custom_api.xml" />
        <exclude domain="sharedpref" path="besharp_secure_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
